# ============================================================
# Konfigurasi Environment (isi sesuai kebutuhan kamu)
# ============================================================

# PERSISTENSI DATA DI VERCEL (pilih SALAH SATU backend):
#
# Opsi A — Upstash Redis (REKOMENDASI, gratis via Vercel Marketplace "Redis"):
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxx
#
# Opsi B — Vercel KV (KV lama; variabel otomatis di-set bila project punya KV):
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxxxxxxx
#
# Opsi C — PostgreSQL (gratis dari Neon.tech / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL=true

# Auth — login credentials (GANTI password di production!)
AUTH_USERNAME=PIMPINAN RANTING BAROS
AUTH_PASSWORD=pelajarnukotasantri
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang

# Port server (Vercel override otomatis)
# PORT=5000