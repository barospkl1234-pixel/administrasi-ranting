# ============================================================
# Konfigurasi Environment (isi sesuai kebutuhan kamu)
# ============================================================

# WAJIB di Vercel dan production:
# Connection string PostgreSQL (gratis dari Neon.tech / Supabase)
# Jika tidak di-set, data hanya tersimpan di file JSON (ephemeral di Vercel!)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opsional - default SSL aktif. Set "false" jika pakai DB tanpa SSL
DATABASE_SSL=true

# Port server (default 5000, Vercel akan override otomatis)
# PORT=5000